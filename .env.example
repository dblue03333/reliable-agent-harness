# Settings are validated at API startup and by the CLI.
# M5 enforces step/runtime/operation limits, bounded tool retries and response repair.
LLM_PROVIDER=fake

# Required only when LLM_PROVIDER=gemini. Never commit a real API key.
# Live schema smoke verified gemini-3.5-flash-lite on 2026-09-29 (SDK 1.75.0).
# Set GEMINI_MODEL explicitly when enabling Gemini, then rerun smoke for your access.
GEMINI_API_KEY=
GEMINI_MODEL=

MAX_AGENT_STEPS=10
MAX_ACTIVE_RUNTIME_SECONDS=60
LLM_TIMEOUT_SECONDS=20
DEFAULT_TOOL_TIMEOUT_SECONDS=5
# Execution-wide malformed-response repair allowance (0 disables repair; hard cap 1).
MAX_LLM_REPAIR_ATTEMPTS=1
# Retry counts exclude the initial attempt; hard caps are 2 and 1 respectively.
MAX_READ_TOOL_RETRIES=2
MAX_INCIDENT_RETRIES=1
LOG_LEVEL=INFO
