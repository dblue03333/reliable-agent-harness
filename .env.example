# Settings are validated at API startup and by the CLI.
# M2 enforces step/runtime/operation limits in the read loop; Gemini arrives in M3.
LLM_PROVIDER=fake

# Required only when LLM_PROVIDER=gemini. Never commit a real API key.
# Use a real model ID verified during M3; no live integration is claimed yet.
GEMINI_API_KEY=
GEMINI_MODEL=

MAX_AGENT_STEPS=10
MAX_ACTIVE_RUNTIME_SECONDS=60
LLM_TIMEOUT_SECONDS=20
DEFAULT_TOOL_TIMEOUT_SECONDS=5
# Reserved for M5: M2 fails on malformed output/tool errors without repair or retry.
MAX_LLM_REPAIR_ATTEMPTS=1
# Retry counts exclude the initial attempt; hard caps are 2 and 1 respectively.
MAX_READ_TOOL_RETRIES=2
MAX_INCIDENT_RETRIES=1
LOG_LEVEL=INFO
