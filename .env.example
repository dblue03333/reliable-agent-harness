# M0 parses and validates these settings at API startup.
# Loop enforcement (M2/M5) and provider implementations (M2/M3) are not built yet.
LLM_PROVIDER=fake

# Required only when LLM_PROVIDER=gemini. Never commit a real API key.
# Use a real model ID verified during M3; no live integration is claimed in M0.
GEMINI_API_KEY=
GEMINI_MODEL=

MAX_AGENT_STEPS=10
MAX_ACTIVE_RUNTIME_SECONDS=60
LLM_TIMEOUT_SECONDS=20
DEFAULT_TOOL_TIMEOUT_SECONDS=5
MAX_LLM_REPAIR_ATTEMPTS=1
# Retry counts exclude the initial attempt; hard caps are 2 and 1 respectively.
MAX_READ_TOOL_RETRIES=2
MAX_INCIDENT_RETRIES=1
LOG_LEVEL=INFO
